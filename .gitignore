# Виртуальное окружение — ставится install.bat, в репозиторий не нужен
.venv/
venv/

# База данных и её служебные файлы: создаются при первом запуске.
# В репозитории хранится только структура, но НЕ содержимое —
# это персональные данные вуза и демо-цифры, которые меняются.
data/*.db
data/*.db-wal
data/*.db-shm
data/backup/

# Журналы
logs/
*.log

# Документы вуза в репозиторий не попадают: отчёты, приказы и опросы
# работодателей — внутренние данные, а репозиторий публичный.
# В git остаются только демонстрационные файлы (вымышленные числа).
knowledge/**
!knowledge/demo/
!knowledge/demo/**
!knowledge/README.md

# Пароли, выданные при первом запуске, и резервные копии базы
data/initial_passwords.txt

# Кэш и мусор
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
Thumbs.db

# Локальное окружение редактора
.vscode/
.idea/